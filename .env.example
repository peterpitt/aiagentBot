# ===========================================================================
# 至少啟用一個供應商。前端的「模型」下拉選單只會顯示這裡有設定的供應商。
# 複製此檔為 .env.local 後填入。
# ===========================================================================

# （選填）預設選取的供應商 id：claude / ollama / qwen / nvidia / deepseek
# DEFAULT_PROVIDER=claude

# ---------------------------------------------------------------------------
# 1) Claude（Anthropic）— 雲端
#    取得金鑰：https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-opus-5-5          # 可改 claude-sonnet-5-5 / claude-haiku-5-5

# ---------------------------------------------------------------------------
# 2) Ollama — 本地模型（OpenAI 相容）
#    安裝：https://ollama.com ；先 `ollama pull qwen2.5` 再 `ollama serve`
#    設定下列任一個即會在選單出現。
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5                  # 例：qwen2.5:14b、llama3.1、gemma2…
# OLLAMA_ENABLED=1                      # 想用預設 baseURL 時，設這個也能啟用

# ---------------------------------------------------------------------------
# 3) Qwen（通義千問）— DashScope 雲端，或自架 vLLM/Ollama（OpenAI 相容）
#    DashScope 金鑰：https://dashscope.console.aliyun.com/
# ---------------------------------------------------------------------------
# QWEN_API_KEY=sk-xxxxxxxx
# QWEN_MODEL=qwen-max                   # 例：qwen-max、qwen-plus、qwen2.5-72b-instruct
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   自架本地 Qwen 範例：QWEN_BASE_URL=http://localhost:8000/v1 （vLLM）

# ---------------------------------------------------------------------------
# 4) NVIDIA Nemotron — build.nvidia.com 雲端 NIM，或自架 NIM 容器（OpenAI 相容）
#    雲端金鑰：https://build.nvidia.com/
# ---------------------------------------------------------------------------
# NVIDIA_API_KEY=nvapi-xxxxxxxx
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#   自架 NIM 範例：NVIDIA_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# 5) DeepSeek — 官方雲端（OpenAI 相容），或自架
#    金鑰：https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat            # 或 deepseek-reasoner（R1，含思維鏈）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#   自架本地 DeepSeek 範例：DEEPSEEK_BASE_URL=http://localhost:11434/v1（Ollama）

# ---------------------------------------------------------------------------
# （選填）OpenAI 相容端點（Ollama/Qwen/NVIDIA/DeepSeek）的輸出 token 上限。
# 本地模型 context 較小時可設低一點；不設則由各端點自行決定。
# OPENAI_MAX_TOKENS=8192

# ===========================================================================
# Telegram bot（讓你用手機隨時呼叫，執行 `npm run bot`）
#   1. 在 Telegram 找 @BotFather → /newbot → 取得 token
#   2. 傳 /whoami 給你的 bot 可查到自己的數字 ID，填進 ALLOWED_USERS 做白名單
# ===========================================================================
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
# TELEGRAM_ALLOWED_USERS=123456789          # 逗號分隔；留空=任何人都能用（不建議）
# BOT_PROVIDER=ollama                        # bot 預設供應商（可在聊天中用 /use 切換）
# BOT_MODEL=qwen2.5                          # bot 預設模型
